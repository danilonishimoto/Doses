# ===================================================================
# Doses Backend - Configuração de Variáveis de Ambiente (Exemplo)
# ===================================================================
# ATENÇÃO: NUNCA versione o arquivo .env real no Git.
# Para iniciar em desenvolvimento local, copie este arquivo para .env
# e execute `npm run generate-vapid` para criar suas chaves VAPID locais.
# ===================================================================

# Configuração do Servidor
NODE_ENV=development
PORT=3333
HOST=localhost
CORS_ORIGIN=http://localhost:5173

# Fuso Horário de Referência dos Lembretes
APP_TIMEZONE=America/Sao_Paulo

# Banco de Dados Local (SQLite)
DATABASE_FILE=./data/doses.db

# Autenticação e Sessões (Mínimo de 32 caracteres em produção)
JWT_SECRET=doses_local_development_jwt_secret_min_32_characters_long_12345
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Web Push (VAPID RFC 8292)
# Execute `npm run generate-vapid` para gerar um par de chaves próprio local
VAPID_PUBLIC_KEY=example_base64_encoded_vapid_public_key_to_be_generated
VAPID_PRIVATE_KEY=example_base64_encoded_vapid_private_key_to_be_generated
VAPID_SUBJECT=mailto:suporte-dev@dosesapp.com.br
